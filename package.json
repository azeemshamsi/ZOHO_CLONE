{
  "name": "mgi",
  "version": "1.0.0",
  "description": "MGI — GST-ready accounting and invoicing",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm ci --prefix backend --omit=dev && npm ci --prefix frontend && npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "npm test --prefix backend"
  }
}
