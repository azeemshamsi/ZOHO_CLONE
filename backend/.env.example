# Copy to backend/.env for local development. On Render, set these in the dashboard.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mgi?retryWrites=true&w=majority

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Public address of the app (used in email links)
APP_URL=http://localhost:5173

# Optional: email for password reset / verification (Gmail needs an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=false
